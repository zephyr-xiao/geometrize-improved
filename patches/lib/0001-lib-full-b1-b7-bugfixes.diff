+{}
+
+Model::~Model()
+{}
+
+void Model::reset(const geometrize::rgba backgroundColor)
+{
+    d->reset(backgroundColor);
+}
+
+std::int32_t Model::getWidth() const
+{
+    return d->getWidth();
+}
+
+std::int32_t Model::getHeight() const
