+            downscaled.back().x2 = (std::max)(downscaled.back().x2, x2);
+        } else {
+            downscaled.emplace_back(Scanline(y, x1, x2));
+        }
+    }
+
+    return geometrize::trimScanlines(downscaled, 0, 0, halfWidth, halfHeight);
+}
+
 }
