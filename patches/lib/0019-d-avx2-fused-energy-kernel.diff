+    // 按几何判定而非形状类型:能量函数侧拿不到 Shape,共享谓词保证评估/落画两侧颜色模型一致。
+    for(const geometrize::Scanline& line : lines) {
+        if(line.x1 != line.x2) {
+            return false;
+        }
+    }
+    return true;
