+void drawShapeOnCanvas(geometrize::Bitmap& canvas, const geometrize::ShapeResult& shape)
+{
+    std::vector<geometrize::Scanline> lines{shape.shape->rasterize(*shape.shape)};
+    if(!shape.segments.empty()) {
