+template<typename Archive>
+void serialize(Archive& ar, geometrize::ImageRunnerPriorityRegionOptions& region)
+{
+    ar(cereal::make_nvp("xMinPercent", region.xMinPercent),
+       cereal::make_nvp("yMinPercent", region.yMinPercent),
+       cereal::make_nvp("xMaxPercent", region.xMaxPercent),
+       cereal::make_nvp("yMaxPercent", region.yMaxPercent));
