+class ImageTaskPreferences::ImageTaskPreferencesImpl
+{
+public:
+    ImageTaskPreferencesImpl()
+    {
+    }
+
+    ImageTaskPreferencesImpl(const std::string& filePath)
+    {
+        load(filePath);
+    }
