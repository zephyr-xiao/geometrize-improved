+std::string getFirstFileWithAnyExtension(const std::string& dirPath, const std::vector<std::string>& extensions)
+{
+    for(const std::string& filePath : getFilePathsForDirectory(dirPath)) {
+        for(const std::string& ext : extensions) {
+            if(endsWith(filePath, ext)) {
+                return filePath;
+            }
+        }
+    }
+    return "";
+}
