+template<typename T>
+void split(const std::string& s, const char delimiter, T result)
+{
+    std::stringstream ss;
+    ss.str(s);
+    std::string item;
+    while (std::getline(ss, item, delimiter)) {
+        *(result++) = item;
+    }
+}
