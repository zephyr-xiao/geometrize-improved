+bool writeStringToFile(const std::string& str, const std::string& path)
+{
+    std::ofstream out(path, std::ios::trunc | std::ios::out);
+    if(!out.is_open()) {
+        return false;
+    }
+
+    if(out) {
+        out << str;
+    }
+
+    out.close();
+
+    if(!out) {
+        return false;
+    }
+
+    return true;
+}
