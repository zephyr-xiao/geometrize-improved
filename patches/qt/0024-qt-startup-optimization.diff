+void messageBox(const std::string& str)
+{
+    QMessageBox msgBox;
+    msgBox.setText(QString::fromStdString(str));
+    msgBox.exec();
+}
+
+void processApplicationEvents()
+{
+    QCoreApplication* app = QCoreApplication::instance();
+    if(app == nullptr) {
+        assert(0 && "Application instance pointer is null");
+        return;
+    }
+    app->processEvents();
+}
