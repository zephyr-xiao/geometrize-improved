+void debugBreak()
+{
+#ifdef _MSC_VER
+    __debugbreak();
+#elif __MINGW32__
+    // Not sure how to break here...
+    assert(0 && "Mingw32 debug break");
+#else
+    raise(SIGTRAP);
+#endif
+}
