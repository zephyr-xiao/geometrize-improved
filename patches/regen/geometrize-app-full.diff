+        return;
+    }
+    const std::string filePath{startupTimingLogPath()};
+    const QFileInfo info(QString::fromStdString(filePath));
+    const QDir dir(info.absoluteDir());
+    if(!dir.exists() && !dir.mkpath(dir.absolutePath())) {
+        return;
+    }
