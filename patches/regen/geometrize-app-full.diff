+        px = static_cast<const geometrize::Circle&>(s).m_x;
+        py = static_cast<const geometrize::Circle&>(s).m_y;
+        break;
+    case geometrize::ShapeTypes::ELLIPSE:
+        px = static_cast<const geometrize::Ellipse&>(s).m_x;
+        py = static_cast<const geometrize::Ellipse&>(s).m_y;
+        break;
+    case geometrize::ShapeTypes::ROTATED_ELLIPSE:
+        px = static_cast<const geometrize::RotatedEllipse&>(s).m_x;
+        py = static_cast<const geometrize::RotatedEllipse&>(s).m_y;
+        break;
+    case geometrize::ShapeTypes::RECTANGLE:
+    {
+        const geometrize::Rectangle& r{static_cast<const geometrize::Rectangle&>(s)};
+        px = (r.m_x1 + r.m_x2) / 2.0F;
+        py = (r.m_y1 + r.m_y2) / 2.0F;
+        break;
+    }
+    case geometrize::ShapeTypes::ROTATED_RECTANGLE:
+    {
+        const geometrize::RotatedRectangle& r{static_cast<const geometrize::RotatedRectangle&>(s)};
+        px = (r.m_x1 + r.m_x2) / 2.0F;
+        py = (r.m_y1 + r.m_y2) / 2.0F;
+        break;
+    }
+    case geometrize::ShapeTypes::TRIANGLE:
+    {
+        const geometrize::Triangle& t{static_cast<const geometrize::Triangle&>(s)};
+        px = (t.m_x1 + t.m_x2 + t.m_x3) / 3.0F;
+        py = (t.m_y1 + t.m_y2 + t.m_y3) / 3.0F;
+        break;
+    }
+    case geometrize::ShapeTypes::LINE:
+    {
+        const geometrize::Line& l{static_cast<const geometrize::Line&>(s)};
+        px = (l.m_x1 + l.m_x2) / 2.0F;
+        py = (l.m_y1 + l.m_y2) / 2.0F;
+        break;
+    }
+    case geometrize::ShapeTypes::QUADRATIC_BEZIER:
+    {
+        const geometrize::QuadraticBezier& b{static_cast<const geometrize::QuadraticBezier&>(s)};
+        px = (b.m_x1 + b.m_cx + b.m_x2) / 3.0F;
+        py = (b.m_y1 + b.m_cy + b.m_y2) / 3.0F;
+        break;
+    }
+    case geometrize::ShapeTypes::POLYLINE:
+    {
+        const geometrize::Polyline& p{static_cast<const geometrize::Polyline&>(s)};
+        if(p.m_points.empty()) {
+            shift = false;
+            break;
+        }
+        for(const auto& point : p.m_points) {
+            px += point.first;
+            py += point.second;
+        }
+        px /= static_cast<float>(p.m_points.size());
+        py /= static_cast<float>(p.m_points.size());
+        break;
+    }
+    default:
+        shift = false;
+        break;
+    }
+
+    if(shift) {
