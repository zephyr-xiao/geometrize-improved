+        const std::int32_t g{static_cast<std::int32_t>(sumG / runRectCount)};
+        const std::int32_t b{static_cast<std::int32_t>(sumB / runRectCount)};
+        stream << "<rect x=\"" << runX1 << "\" y=\"" << runStartY << "\" width=\""
