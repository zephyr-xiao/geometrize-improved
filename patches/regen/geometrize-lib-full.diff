+                m_condition.wait(lock, [this] { return m_stop || !m_tasks.empty(); });
+                if(m_stop && m_tasks.empty()) {
+                    return;
+                }
+                task = std::move(m_tasks.front());
+                m_tasks.pop();
+            }
+            task();
+        }
+    }
