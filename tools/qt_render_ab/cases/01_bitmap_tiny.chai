// 用例 01:位图路径严格对拍(64×64 / 全形状类型 / 固定种子 / 单线程)
// 产物:*_bitmap_tiny.bitmap.png(逐像素严格) + *_bitmap_tiny.json(形状 JSON 逐字节严格)
// 说明:脚本异常走 try/catch 落 status 文件,避免 runScript 弹出模态框挂死 headless 运行。
try
{
    var image = loadImage("@IN@/tiny_64.png");
    var bitmap = createBitmap(convertImageToRgba8888(image));

    var prefs = ImageTaskPreferences();
    prefs.setSeed(1000);
    prefs.setMaxThreads(1);
    prefs.setShapeAlpha(255);
    prefs.setCandidateShapeCount(50);
    prefs.setMaxShapeMutations(100);
    prefs.setShapeTypes(RECTANGLE);
    prefs.enableShapeTypes(ROTATED_RECTANGLE);
    prefs.enableShapeTypes(TRIANGLE);
    prefs.enableShapeTypes(ELLIPSE);
    prefs.enableShapeTypes(ROTATED_ELLIPSE);
    prefs.enableShapeTypes(CIRCLE);
    prefs.enableShapeTypes(LINE);
    prefs.enableShapeTypes(QUADRATIC_BEZIER);
    prefs.enableShapeTypes(POLYLINE);

    var task = SynchronousImageTask(bitmap);
    task.setPreferences(prefs);
    task.drawBackgroundRectangle();
    for (var i = 0; i < 100; ++i)
    {
        task.stepModel();
    }

    exportBitmap(task.getCurrent(), "@OUT@/01_bitmap_tiny.bitmap.png");
    writeStringToFile(exportShapeJson(task.getShapes()), "@OUT@/01_bitmap_tiny.json");
    writeStringToFile("PASS", "@OUT@/01_bitmap_tiny.status.txt");
    printToConsole("CASE 01 PASS\n");
}
catch (e)
{
    writeStringToFile("FAIL", "@OUT@/01_bitmap_tiny.status.txt");
    printToConsole("CASE 01 FAIL: " + to_string(e) + "\n");
}
