// 用例 03:SVG 光栅化路径量化对拍(64×64 形状 → 2× 放大光栅化)
// 产物:*_svg_raster.raster.png(走 QSvgRenderer,Qt 6.7+ 重写过 SVG 模块,允许微小差异,量化报告)
try
{
    var image = loadImage("@IN@/tiny_64.png");
    var bitmap = createBitmap(convertImageToRgba8888(image));

    var prefs = ImageTaskPreferences();
    prefs.setSeed(1000);
    prefs.setMaxThreads(1);
    prefs.setShapeAlpha(255);
    prefs.setCandidateShapeCount(50);
    prefs.setMaxShapeMutations(100);
    prefs.setShapeTypes(RECTANGLE);
    prefs.enableShapeTypes(ROTATED_RECTANGLE);
    prefs.enableShapeTypes(TRIANGLE);
    prefs.enableShapeTypes(ELLIPSE);
    prefs.enableShapeTypes(ROTATED_ELLIPSE);
    prefs.enableShapeTypes(CIRCLE);
    prefs.enableShapeTypes(LINE);
    prefs.enableShapeTypes(POLYLINE);

    var task = SynchronousImageTask(bitmap);
    task.setPreferences(prefs);
    task.drawBackgroundRectangle();
    for (var i = 0; i < 100; ++i)
    {
        task.stepModel();
    }

    exportRasterizedSvg(task.getShapes(), 64, 64, 128, 128, "@OUT@/03_svg_raster.raster.png");
    writeStringToFile("PASS", "@OUT@/03_svg_raster.status.txt");
    printToConsole("CASE 03 PASS\n");
}
catch (e)
{
    writeStringToFile("FAIL", "@OUT@/03_svg_raster.status.txt");
    printToConsole("CASE 03 FAIL: " + to_string(e) + "\n");
}
